SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# Must include the scheme (https://) and match the domain Coolify serves this on.
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- Database (docker-compose.yml builds DATABASE_URL from these) -----
POSTGRES_DB=sporttech
POSTGRES_USER=sporttech
POSTGRES_PASSWORD=replace-with-a-strong-password

RUN_SEED_DEMO=false

CELERY_TASK_ALWAYS_EAGER=False

# --- Email (optional - defaults to logging emails to the console) -----
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- Payments (optional) -----------------------------------------------
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=

# Firebase Admin service account - for Google sign-in verification and real
# FCM push notifications. Get it from Firebase Console -> Project Settings
# -> Service Accounts -> Generate new private key. Set ONE of these two:
# - FIREBASE_CREDENTIALS_PATH: path to the downloaded JSON file (local dev).
# - FIREBASE_CREDENTIALS_JSON: the file's contents pasted as one env var
#   (preferred in production/PaaS - no file to deploy alongside the image).
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=

# --- S3-compatible media storage (optional) -----------------------------
# Only needed if you want uploaded media (product photos, seller documents,
# avatars) on object storage instead of the "media_data" Docker volume.
# Also requires adding `django-storages` to requirements.txt - it isn't
# installed by default.
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=
